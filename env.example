
# Copia este archivo a .env en local (en Render usa Environment Variables)

# Discord Application → OAuth2
DISCORD_CLIENT_ID=tu_client_id
DISCORD_CLIENT_SECRET=tu_client_secret

# Debe coincidir EXACTO con el Redirect de Discord Developer Portal
# Ejemplo Render: https://odette-panel.onrender.com/callback
DISCORD_REDIRECT_URI=https://TU-SERVICIO.onrender.com/callback

# Dueña del bot (puede gestionar premium desde la web)
BOT_OWNER_ID=545930956721356842

# Clave secreta de sesión (pon una cadena larga aleatoria)
SECRET_KEY=cambia-esta-clave-por-una-muy-larga-y-random

# Token para que el bot sincronice config (MISMO valor en el .env del bot)
PANEL_API_TOKEN=yZLUyyjWWSuAYU_hB8u22U3-asSG85fIbP4mKJ_gVRQ
